# Copy to .env.local and fill in. Not needed for the no-backend preview (open the app with ?mock=1).
VITE_SUPABASE_URL=https://<project-ref>.supabase.co
VITE_SUPABASE_ANON_KEY=<publishable/anon key>
VITE_SPOTPAY_CONTRACT_ID=spotpayv2.sweetfrog-treasury.testnet
VITE_NEAR_NETWORK=testnet
# Optional, defaults to the public FastNEAR testnet RPC
VITE_NEAR_RPC_URL=https://test.rpc.fastnear.com
