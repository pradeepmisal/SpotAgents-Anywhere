# Edge Function secrets for the ax-* functions. Set with:
#   npx supabase secrets set --env-file supabase/functions/.env
# SUPABASE_URL and the service-role key are provided by Supabase automatically.
SERV_API_KEY=<key from console.openserv.ai>
SERV_COMPILE_MODEL=gpt-5.4-mini
SERV_CHAT_MODEL=gpt-5.4-mini
REPPO_API_KEY=<key from eval.reppo.xyz>
KITE_AGENT_PRIVATE_KEY=<testnet-only tour agent key>
KITE_AGENT_ADDRESS=<0x...>
KITE_PAYTO_ADDRESS=<0x...>
KITE_RPC_URL=https://rpc-testnet.gokite.ai/
KITE_ASSET_ADDRESS=0x38129cf4CE5E183eFF248F42A7D345Bb1B47621A
KITE_FACILITATOR_URL=https://facilitator.pieverse.io/v2
SEED_KEY=<random string, only for scripts/seed-anywhere.mjs>
