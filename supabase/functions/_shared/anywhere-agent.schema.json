{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "CompiledAgent",
  "description": "What SERV Reasoning must return when compiling an expert's notes. FROZEN 2026-11-15. Validated server-side before saving.",
  "type": "object",
  "additionalProperties": false,
  "required": ["persona", "greeting", "facts", "stories", "teaser", "premium", "suggested_questions", "languages"],
  "properties": {
    "persona": { "type": "string", "minLength": 20, "maxLength": 600, "description": "How the agent speaks, in second person: 'You are ...'" },
    "greeting": { "type": "string", "minLength": 10, "maxLength": 300, "description": "First line spoken when a visitor arrives" },
    "facts": {
      "type": "array", "minItems": 1, "maxItems": 6,
      "items": {
        "type": "object", "additionalProperties": false, "required": ["claim", "basis"],
        "properties": {
          "claim": { "type": "string", "minLength": 5, "maxLength": 300 },
          "basis": { "type": "string", "enum": ["from_notes", "common_knowledge"] }
        }
      }
    },
    "stories": {
      "type": "array", "minItems": 0, "maxItems": 3,
      "items": {
        "type": "object", "additionalProperties": false, "required": ["title", "text", "kind"],
        "properties": {
          "title": { "type": "string", "maxLength": 80 },
          "text": { "type": "string", "maxLength": 900 },
          "kind": { "type": "string", "enum": ["personal_memory", "local_legend", "practical_tip"] }
        }
      }
    },
    "teaser": { "type": "string", "minLength": 20, "maxLength": 600, "description": "What the free first answer may draw on" },
    "premium": { "type": "string", "minLength": 20, "maxLength": 3000, "description": "Deep content unlocked after payment" },
    "suggested_questions": { "type": "array", "minItems": 3, "maxItems": 3, "items": { "type": "string", "maxLength": 80 } },
    "languages": { "type": "array", "minItems": 1, "maxItems": 4, "items": { "type": "string", "maxLength": 20 } }
  }
}
